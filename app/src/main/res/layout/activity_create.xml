<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Sound Sticker"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Sticker preview in a rounded card frame: tap to play the
             attached sound. In video mode a live TextureView player stacks
             above the still ImageView preview. -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Sticker preview"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_logo" />

            <TextureView
                android:id="@+id/texturePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Tap the sticker to hear its sound"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickPhoto"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pick Photo"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="14dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnPickVideo"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Pick Video"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="14dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Video mode: trim + crop controls (visible only for videos) -->
        <LinearLayout
            android:id="@+id/layoutVideoControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Animated video sticker — trim &amp; crop"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTrimInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtTrimStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Start: 0.0s"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekTrimStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sticker length"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbLen1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1s"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbLen2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2s"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbLen3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="3s"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Zoom (crop closer)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Move crop left / right"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekCropX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Move crop up / down"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekCropY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Caption on sticker (optional)"
            app:boxBackgroundMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:maxLines="2"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.08"
            android:text="Add a sound"
            android:textAllCaps="true"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSoundStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No sound attached yet"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRecord"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎙 Record Voice (max 10s)"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnPickAudio"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎵 Pick Audio File"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnEffects"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✨ Built-in Sound Effects"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnTts"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🗣 Text-to-Speech"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnVideoSound"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔊 Use Video's Own Sound"
            android:textColor="@color/text_primary"
            android:visibility="gone"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnPlaySound"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="▶ Play Sound"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:text="Save Sticker to Pack"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
